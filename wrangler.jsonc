{
  // Cloudflare 배포 설정.
  //
  // Cloudflare 대시보드의 Build command 가 비어 있어도 배포가 되도록,
  // 아래 build.command 에서 직접 빌드한다.
  // (`npx wrangler deploy` → 먼저 npm run build → out/ 폴더를 올린다)
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "average",
  "compatibility_date": "2026-09-01",
  "build": {
    "command": "npm run build"
  },
  "assets": {
    // 정적으로 내보낸 결과물 폴더
    "directory": "./out",
    // 없는 주소로 들어오면 404.html 을 보여준다
    "not_found_handling": "404-page"
  }
}
